{{!< default}}

<div class="with-sidebar">
    <div class="gh-outer">
        <main class="site-main gh-inner">

            <div class="post-feed gh-feed">
                {{#foreach posts}}
                    {{> "loop"}}
                {{/foreach}}
            </div>

        </main>
    </div>

    <div class="sidebar" style="display: none;">
        {{> "sidebar"}}
    </div>
</div>